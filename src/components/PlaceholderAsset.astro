---
interface Props {
  name: string;
  ratio: string;
  description: string;
  notes: string;
  altSuggestion: string;
}

const { name, ratio, description, notes, altSuggestion } = Astro.props;
---

<figure class="placeholder-asset" aria-label={altSuggestion}>
  <div class="placeholder-stage" aria-hidden="true">
    <span class="placeholder-jar"></span>
    <span class="placeholder-box"></span>
    <span class="placeholder-gloss"></span>
  </div>
  <figcaption class="placeholder-caption">
    <p class="placeholder-kicker">Image pending</p>
    <h3>{name}</h3>
    <details>
      <summary>Asset notes</summary>
      <dl>
        <div>
          <dt>Ratio</dt>
          <dd>{ratio}</dd>
        </div>
        <div>
          <dt>Visual</dt>
          <dd>{description}</dd>
        </div>
        <div>
          <dt>Notes</dt>
          <dd>{notes}</dd>
        </div>
        <div>
          <dt>Alt</dt>
          <dd>{altSuggestion}</dd>
        </div>
      </dl>
    </details>
  </figcaption>
</figure>
