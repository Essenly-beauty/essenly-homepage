---
import { siteConfig } from "../../data/siteConfig";

const { product } = siteConfig;
---

<section class="l-brand">
  <img
    src="/images/essenly/essenly-band-wide.jpg"
    alt={`A model with damp hair holding a jar of ${product.shortName}`}
    loading="lazy"
  />
  <div class="l-brand__top">
    <p class="l-brand__word">essenly.</p>
    <p class="l-brand__tag">Powered by RenewShell&trade;</p>
  </div>
  <div class="l-brand__bottom">
    <p class="l-brand__big">5 min</p>
    <p class="l-brand__caption">In the shower. In silence.</p>
  </div>
</section>
