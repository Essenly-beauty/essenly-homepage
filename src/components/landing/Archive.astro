---
import { siteConfig } from "../../data/siteConfig";
import Rise from "./Rise.astro";

const { product } = siteConfig;
---

<section class="l-archive section">
  <div class="container">
    <div class="l-archive__head">
      <p class="eyebrow"><span>The archive</span></p>
      <h2 class="h-section">One use.<br />A difference you can see.</h2>
    </div>
    <div class="l-archive__imgs">
      <Rise>
        <img
          src="/images/essenly/essenly-generated-science-macro.png"
          alt={`A macro view of the conditioning texture behind ${product.shortName}`}
          loading="lazy"
        />
        <p class="l-archive__cap">Gloss after a single treatment.</p>
      </Rise>
      <Rise>
        <img
          src="/images/essenly/essenly-product-official-top.jpg"
          alt={`The official top view of ${product.shortName} packaging`}
          loading="lazy"
        />
        <p class="l-archive__cap">{product.countryOfOrigin}.</p>
      </Rise>
    </div>
  </div>
</section>
