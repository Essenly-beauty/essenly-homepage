---
import { siteConfig } from "../../data/siteConfig";
import Rise from "./Rise.astro";

const { product } = siteConfig;
---

<section class="l-archive section">
  <div class="container">
    <div class="l-archive__head">
      <p class="eyebrow"><span>The archive</span></p>
      <h2 class="h-section">One use.<br />A difference you can see.</h2>
    </div>
    <div class="l-archive__imgs">
      <Rise>
        <img
          src="/images/essenly/essenly-product-primary.jpg"
          alt={`The same hair before and after one use of ${product.shortName}`}
          loading="lazy"
        />
        <p class="l-archive__cap">Before and after a single treatment.</p>
      </Rise>
      <Rise>
        <img
          src="/images/essenly/essenly-archive-b.jpg"
          alt={`A jar of ${product.shortName} in water`}
          loading="lazy"
        />
        <p class="l-archive__cap">{product.countryOfOrigin}.</p>
      </Rise>
    </div>
  </div>
</section>
