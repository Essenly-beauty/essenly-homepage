<style is:global>
  /* No `color` here on purpose: it would land at the same specificity as the
     caller's own class and, being emitted later, would win — repainting the
     footer lockup in the footer's white instead of its peach. */
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    text-decoration: none;
  }

  .brand-lockup__mark {
    width: auto;
    height: 1.06em;
    flex: none;
  }

  .brand-lockup__word {
    width: auto;
    height: 0.62em;
    flex: none;
    /* The wordmark's baseline sits below the mark's optical centre. */
    margin-top: 0.04em;
  }
</style>
