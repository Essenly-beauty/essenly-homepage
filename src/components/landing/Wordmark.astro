---
/*
  The brand lockup: the three-stroke hair mark with its peach bead, followed by
  the wordmark set in the display serif. This is the treatment the trade page at
  /wholesale already carries, and it is now the single lockup the whole site uses.

  It replaces the imported #FDB7A5 wordmark asset, which was a single flat SVG:
  that file only ever scaled by height, sat at roughly 1.7:1 on white, and shared
  nothing with the serif the rest of the page is set in.

  Everything is sized in `em`, so a caller sets one `font-size` and the mark, the
  gap and the wordmark scale together. Colour comes from `currentColor` — only
  the bead is fixed, because it is the one part that stays peach on either ground.
*/
interface Props {
  class?: string;
  href?: string;
  label?: string;
}

const { class: className, href = "#top", label = "Essenly home" } = Astro.props;
---

<a class:list={["brand-lockup", className]} href={href} aria-label={label}>
  <svg class="brand-lockup__mark" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M3 16.5C7.3 8.8 12.2 17.2 21 5.5" />
    <path d="M3 20C8.1 11.6 13.6 18.8 21 9" />
    <path d="M3.5 12.5C7.8 6.2 12 13.2 20.5 3.5" />
    <circle cx="15.4" cy="8.6" r="1.55" />
  </svg>
  <span class="brand-lockup__word">essenly</span>
</a>

<style is:global>
  /* No `color` here on purpose: it would land at the same specificity as the
     caller's own class and, being emitted later, would win — repainting the
     footer lockup in the footer's white instead of its peach. */
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.39em;
    text-decoration: none;
  }

  .brand-lockup__mark {
    width: 0.91em;
    height: 0.91em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
  }

  /* The bead is the one fixed colour: it reads as the brand clay on white and
     still separates from the strokes on the black footer. */
  .brand-lockup__mark circle {
    fill: #e9b393;
    stroke: none;
  }

  .brand-lockup__word {
    font-family: var(--font-display);
    font-size: 1em;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.015em;
  }
</style>
