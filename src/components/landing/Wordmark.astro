---
/*
  The wordmark inlined so its colour comes from CSS `color` rather than a baked-in
  fill. The source file paints everything #FDB7A5, which sits at roughly 1.7:1 on
  white — legible enough as a logo but washed out at header scale. Inlining lets
  the header use the deeper clay while the footer keeps the light peach on black.

  Kept in sync with public/images/essenly/essenly-logo-wordmark.svg by hand; that
  file is still the canonical asset and is what the og:image and any external
  reference should use.
*/
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
