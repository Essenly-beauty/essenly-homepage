---
/*
  The brand lockup: the mark, then the wordmark, both from the supplied artwork.

  The source files were 430KB Illustrator exports that were 99% metadata, and
  they painted themselves #f6bfab through a class in an embedded stylesheet — so
  they could not take a colour from the page. The paths are inlined here with
  `fill="currentColor"` instead, which is what lets the header render it in ink
  and the footers in peach from the same component.

  Sized in `em` throughout: a caller sets one `font-size` and the mark, the gap
  and the wordmark scale together.
*/
interface Props {
  class?: string;
  href?: string;
  label?: string;
}

const { class: className, href = "#top", label = "Essenly home" } = Astro.props;
