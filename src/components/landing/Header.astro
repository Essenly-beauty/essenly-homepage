---
import { amazonUrl } from "../../data/siteConfig";
import Wordmark from "./Wordmark.astro";

const nav = [
  { label: "Product", href: "#product" },
  { label: "Science", href: "#science" },
  { label: "Wholesale", href: "#wholesale" },
  { label: "Contact", href: "#contact" },
];
---

<header class="l-header" id="l-header">
  <Wordmark class="l-header__logo" />
  <div class="l-header__right">
    <nav class="l-nav" aria-label="Primary">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="link-arrow l-header__buy" href={amazonUrl} target="_blank" rel="noopener noreferrer">
      Shop on Amazon
    </a>

    {/* A <details> rather than a scripted panel so the mobile nav still opens if
        the motion bundle fails, matching the accordion's approach. */}
    <details class="l-burger">
      <summary aria-label="Open menu"><span></span><span></span></summary>
      <nav aria-label="Mobile navigation">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={amazonUrl} target="_blank" rel="noopener noreferrer">Shop on Amazon</a>
      </nav>
    </details>
  </div>
</header>
