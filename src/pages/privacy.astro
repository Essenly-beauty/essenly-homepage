---
import Legal from "../layouts/Legal.astro";
import { siteConfig } from "../data/siteConfig";
---

<Legal
  title="Privacy Policy"
  description={`Privacy policy for ${siteConfig.company.legalName}`}
  canonicalPath="/privacy"
  eyebrow="Legal"
  heading="Privacy Policy"
>
  <p>
    Essenly collects only the information needed to respond to product, wholesale, press and
    partnership inquiries.
  </p>

  <h2>Information we may collect</h2>
  <p>
    Essenly may collect inquiry details such as name, email address, company name, business type
    and message content when a visitor submits an inquiry form.
  </p>

  <h2>How information may be used</h2>
  <p>
    Inquiry information may be used to respond to messages, evaluate wholesale requests, provide
    product information and maintain business communications.
  </p>

  <h2>Third-party links</h2>
  <p>
    This website links to Amazon U.S. and may link to social media platforms. Those services
    operate under their own privacy policies.
  </p>

  <h2>Contact</h2>
  <p>
    For privacy-related questions, use the <a href="/#contact">inquiry form</a> or email the
    Essenly team directly.
  </p>
</Legal>
