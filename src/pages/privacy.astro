---
import Base from "../layouts/Base.astro";
---

<Base
  title="Privacy Policy"
  description="Privacy policy placeholder for Essenly Co., Ltd."
  canonicalPath="/privacy"
>
  <section class="section">
    <div class="narrow legal stack">
      <p class="eyebrow">Legal</p>
      <h1>Privacy Policy</h1>
      <p class="lead">
        This page is a publication placeholder and should be reviewed by qualified legal counsel
        before the site goes live.
      </p>
      <h2>Information we may collect</h2>
      <p>
        Essenly may collect inquiry details such as name, email address, company name, business
        type and message content when a visitor submits a contact or wholesale form.
      </p>
      <h2>How information may be used</h2>
      <p>
        Inquiry information may be used to respond to messages, evaluate wholesale requests,
        provide product information and maintain business communications.
      </p>
      <h2>Third-party links</h2>
      <p>
        This website links to Amazon U.S. and may link to social media platforms. Those services
        operate under their own privacy policies.
      </p>
      <h2>Contact</h2>
      <p>Official privacy contact details are to be confirmed before launch.</p>
    </div>
  </section>
</Base>

<style>
  .legal h2 {
    margin-top: var(--space-5);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.3;
  }

  .legal p:not(.eyebrow):not(.lead) {
    color: var(--color-muted);
  }
</style>
