---
import Legal from "../layouts/Legal.astro";
import { amazonUrl, getContactEmail } from "../data/siteConfig";

const contactEmail = getContactEmail();
---

<Legal
  title="Thank you"
  description="Your inquiry has reached the Essenly team."
  canonicalPath="/thank-you"
  eyebrow="Inquiry received"
  heading="Thank you."
  noindex
>
  <p>
    Your inquiry has reached the Essenly team. We reply to wholesale and sample requests within two
    business days.
  </p>
  {
    contactEmail && (
      <p>
        If your message is urgent, email <a href={`mailto:${contactEmail}`}>{contactEmail}</a>{" "}
        directly.
      </p>
    )
  }
  <div class="legal-actions">
    <a class="button" href={amazonUrl} target="_blank" rel="noopener noreferrer">
      Shop on Amazon
    </a>
    <a class="button button--quiet" href="/">Back to Essenly</a>
  </div>
</Legal>
