---
import ImageAsset from "../components/ImageAsset.astro";
import Base from "../layouts/Base.astro";
import { amazonUrl, siteConfig } from "../data/siteConfig";

const product = siteConfig.product;
const amazon = siteConfig.amazon;
const wholesale = siteConfig.wholesale;
const wholesaleEmail = siteConfig.contact.wholesaleEmail;
const endpoint = import.meta.env.WHOLESALE_FORM_ENDPOINT as string | undefined;
const showForm = Boolean(endpoint);
const wholesaleReviews = siteConfig.reviews.filter((review) => review.verified && review.purpose === "wholesale");
const supportAssets = siteConfig.supportAssets.filter((asset) => asset.available);

const glanceRows = [
  ["Product type", "Premium rinse-out hair treatment"],
  ["Made in", product.madeIn],
  ["Fragrance", product.fragrance],
  ["Recommended customer", "Customers with dry, frizzy, color-treated or difficult-to-manage hair"],
  ["Recommended use", `${product.useTime} after shampooing`],
  ["Net weight", product.netWeight],
  ["Current U.S. retail price", wholesale.msrp],
  ["Opening order", wholesale.openingMoq ? `From ${wholesale.openingMoq} units` : "Opening orders available upon inquiry"],
  ["Volume pricing", wholesale.volumeMoq ? `Available from ${wholesale.volumeMoq} units` : null],
  ["Wholesale price", "Available upon qualified inquiry"],
  [
    "Fulfillment",
    wholesale.fulfillmentOrigin ?? "Shipping terms provided based on order quantity and destination",
  ],
].filter((row): row is [string, string] => Boolean(row[1]));

const termRows = [
  ["Opening MOQ", wholesale.openingMoq],
  ["Standard wholesale MOQ", wholesale.standardMoq],
  ["Wholesale pricing", "Provided based on order volume"],
  ["Payment", wholesale.paymentTerms],
  ["Shipping", "Quoted based on order size and destination"],
  ["Lead time", wholesale.leadTime],
  ["Samples", wholesale.samplesAvailable ? "Available to qualified buyers" : null],
  ["Returns", wholesale.returnTerms],
  ["Online resale", "Subject to channel approval"],
  ["Exclusivity", "Not available for opening orders"],
].filter((row): row is [string, string] => Boolean(row[1]));
---

<Base
  title="U.S. Wholesale | Essenly Korean Hair Care"
  description="Wholesale opportunities for selected U.S. beauty retailers, salons, head spas and online stores interested in Essenly Korean hair care."
  canonicalPath="/wholesale"
>
  <section class="section wholesale-hero">
    <div class="container split">
      <div class="stack">
        <p class="eyebrow">U.S. Wholesale</p>
        <h1>A sensorial Korean hair treatment for your customers.</h1>
        <p class="lead">
          Essenly is available to selected U.S. beauty retailers, salons, head spas and online stores
          seeking a distinctive premium hair-care product made in Korea.
        </p>
        <div class="button-row">
          <a class="btn btn-primary" href="#inquiry">Request Wholesale Information</a>
          <a class="btn btn-secondary" href="#inquiry">Request a Sample</a>
        </div>
      </div>
      <ImageAsset
        src="/images/essenly/essenly-wholesale-hero.png"
        name="Wholesale hero"
        ratio="16:10"
        description="Retail presentation image with one to three products in a premium beauty setting."
        notes="Avoid warehouse or bulk inventory imagery."
        alt="Essenly Hair Mask presented for premium retail partners"
      />
    </div>
  </section>

  <section class="section sage-band">
    <div class="container">
      <div class="section-title">
        <p class="eyebrow">The retail opportunity</p>
        <h2>A clear story for the shelf.</h2>
        <p class="lead">
          Essenly combines three qualities customers can understand immediately: richer conditioning
          care, a lightweight finish and a memorable Amber Vanilla scent.
        </p>
        <p class="muted">The result is a focused hero product that can be positioned as an elevated alternative to everyday conditioner.</p>
      </div>
      <div class="feature-grid four-up">
        <article>
          <h3>Made in Korea</h3>
          <p>Developed and manufactured in Korea, with a clear connection to the growing interest in Korean beauty and hair care.</p>
        </article>
        <article>
          <h3>Premium at-home ritual</h3>
          <p>A 5-7 minute rinse-out treatment designed for customers who want a more intensive conditioning step at home.</p>
        </article>
        <article>
          <h3>Distinctive sensory identity</h3>
          <p>A rich cream texture and warm Amber Vanilla fragrance help the product stand apart from purely functional hair treatments.</p>
        </article>
        <article>
          <h3>Easy customer story</h3>
          <p>For dry, frizzy or color-treated hair that needs softness, smoother-looking texture and easier manageability.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container data-section">
      <div class="stack">
        <p class="eyebrow">Product at a glance</p>
        <h2>{product.name}</h2>
      </div>
      <dl class="details-list">
        {glanceRows.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section rose-band">
    <div class="container customer-appeal">
      <div class="section-title">
        <p class="eyebrow">Customer appeal</p>
        <h2>Why customers choose Essenly.</h2>
      </div>
      <div class="benefit-grid">
        <article class="info-card">
          <h3>Softness without heaviness</h3>
          <p class="muted">Customers frequently describe softer, moisturized-feeling hair without a greasy or overly coated finish.</p>
        </article>
        <article class="info-card">
          <h3>A smoother-looking result</h3>
          <p class="muted">The product helps improve the appearance of frizz and leaves the hair looking more polished after air-drying or blow-drying.</p>
        </article>
        <article class="info-card">
          <h3>A memorable fragrance</h3>
          <p class="muted">Amber Vanilla gives the treatment an emotional and sensory point of difference beyond basic conditioning.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section review-band">
    <div class="container validation-grid">
      <div class="stack">
        <p class="eyebrow">U.S. customer validation</p>
        <h2>Already available to U.S. customers.</h2>
        <p class="lead">
          Essenly is currently sold through Amazon U.S. and has received positive early customer feedback.
        </p>
        {amazon.rating && amazon.ratingCount && (
          <p class="rating-line">{amazon.rating} out of 5, based on {amazon.ratingCount} customer ratings.</p>
        )}
        <a class="btn btn-secondary" href={amazonUrl} target="_blank" rel="noopener noreferrer">View the Amazon Listing</a>
      </div>
      {wholesaleReviews.length > 0 && (
        <div class="quote-grid">
          {wholesaleReviews.map((review) => <blockquote>"{review.quote}"</blockquote>)}
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container partner-layout">
      <div class="stack">
        <p class="eyebrow">Ideal partners</p>
        <h2>Who we work with.</h2>
      </div>
      <div class="partner-list">
        <p>Independent beauty retailers</p>
        <p>K-beauty stores</p>
        <p>Hair salons and professional stylists</p>
        <p>Head spas</p>
        <p>Spas and wellness boutiques</p>
        <p>Selected online beauty stores</p>
        <p>Small distributors with a defined retail plan</p>
        <p>Curated gift and beauty assortments</p>
      </div>
    </div>
  </section>

  <section class="section sage-band">
    <div class="container data-section">
      <div class="stack">
        <p class="eyebrow">Wholesale terms</p>
        <h2>Designed for a practical opening order.</h2>
        <p class="lead">
          Opening-order terms, volume pricing and shipping options are provided based on your
          business type, order quantity and destination.
        </p>
      </div>
      <dl class="details-list">
        {termRows.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {supportAssets.length > 0 && (
    <section class="section">
      <div class="container partner-layout">
        <div class="stack">
          <p class="eyebrow">Retail support</p>
          <h2>Support for a confident launch.</h2>
        </div>
        <div class="partner-list">
          {supportAssets.map((asset) => <p>{asset.label}</p>)}
        </div>
      </div>
    </section>
  )}

  <section class="section rose-band">
    <div class="container process-layout">
      <div class="stack">
        <p class="eyebrow">Order process</p>
        <h2>A simple direct wholesale process.</h2>
        <p class="lead">Wholesale orders are handled directly by Essenly Co., Ltd.</p>
      </div>
      <ol class="step-list">
        <li>Submit your business information and estimated order.</li>
        <li>Receive wholesale pricing and shipping terms.</li>
        <li>Confirm the order and complete payment.</li>
        <li>Receive shipment and tracking information.</li>
      </ol>
    </div>
  </section>

  <section class="section dark-band" id="inquiry">
    <div class="container inquiry-grid">
      <div class="stack">
        <p class="eyebrow">Inquiry</p>
        <h2>Start a wholesale conversation.</h2>
        <p class="lead">Tell us about your store, customers and estimated opening order.</p>
        <p class="muted">Bring a distinctive Korean hair ritual to your customers.</p>
      </div>
      {showForm ? (
        <form class="inquiry-form" action={endpoint} method="post">
          <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot" />
          <div class="form-grid">
            <div class="field">
              <label for="business-name">Business name</label>
              <input id="business-name" name="business_name" autocomplete="organization" required />
            </div>
            <div class="field">
              <label for="contact-name">Contact name</label>
              <input id="contact-name" name="contact_name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="email">Business email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="website">Website or social account</label>
              <input id="website" name="website" autocomplete="url" />
            </div>
            <div class="field">
              <label for="business-type">Business type</label>
              <select id="business-type" name="business_type" required>
                <option value="">Select one</option>
                <option>Retail Store</option>
                <option>K-Beauty Store</option>
                <option>Hair Salon / Head Spa</option>
                <option>Spa / Wellness</option>
                <option>Online Store</option>
                <option>Distributor</option>
                <option>Other</option>
              </select>
            </div>
            <div class="field">
              <label for="city-state">City and state</label>
              <input id="city-state" name="city_state" required />
            </div>
            <div class="field">
              <label for="order-size">Estimated opening order</label>
              <select id="order-size" name="estimated_order">
                <option value="">Select one</option>
                <option>Under 50 units</option>
                <option>50-149 units</option>
                <option>150-299 units</option>
                <option>300+ units</option>
              </select>
            </div>
            <div class="field checkbox-field">
              <label><input type="checkbox" name="sample_request" /> Sample request</label>
            </div>
            <div class="field full">
              <label for="message">Message</label>
              <textarea id="message" name="message" required></textarea>
            </div>
          </div>
          <button class="btn btn-light" type="submit">Start a Wholesale Conversation</button>
          <p class="fine-print">By submitting, you agree that Essenly may use your information to respond to your inquiry.</p>
        </form>
      ) : (
        <div class="email-fallback">
          <p>Request pricing, samples or product information from the Essenly wholesale team.</p>
          <a class="btn btn-light" href={`mailto:${wholesaleEmail}`}>Contact Wholesale</a>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .section-title {
    display: grid;
    gap: var(--space-4);
    max-width: 820px;
    margin-bottom: var(--space-7);
  }

  .feature-grid,
  .partner-list {
    display: grid;
    gap: 0;
    border-top: 1px solid rgba(31, 25, 21, 0.16);
    border-bottom: 1px solid rgba(31, 25, 21, 0.16);
  }

  .feature-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .feature-grid article,
  .partner-list p {
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-right: 1px solid rgba(31, 25, 21, 0.16);
  }

  .feature-grid article:last-child,
  .partner-list p:nth-child(4n) {
    border-right: 0;
  }

  .feature-grid h3 {
    margin-bottom: var(--space-3);
  }

  .feature-grid p,
  .partner-list p {
    color: var(--color-muted);
  }

  .data-section,
  .partner-layout,
  .process-layout,
  .inquiry-grid,
  .validation-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--space-7);
    align-items: start;
  }

  .details-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .details-list div {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid rgba(36, 30, 25, 0.18);
  }

  .details-list dt {
    font-weight: 800;
  }

  .details-list dd {
    margin: 0;
    color: var(--color-muted);
  }

  .review-band {
    background: var(--color-surface);
    border-block: 1px solid rgba(31, 25, 21, 0.12);
  }

  .rating-line {
    color: var(--color-clay);
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    font-weight: 800;
    line-height: 1.05;
  }

  .partner-list {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .step-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step-list li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-4) 0;
    border-bottom: 1px solid rgba(31, 25, 21, 0.14);
  }

  .step-list li::before {
    content: counter(step);
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgba(31, 25, 21, 0.18);
    border-radius: 50%;
    color: var(--color-clay);
    font-weight: 800;
  }

  .inquiry-form,
  .email-fallback {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid rgba(255, 253, 248, 0.18);
    border-radius: var(--radius);
    background: rgba(255, 253, 248, 0.08);
  }

  .inquiry-form label,
  .email-fallback {
    color: var(--color-surface);
  }

  .checkbox-field {
    align-content: end;
  }

  .checkbox-field label {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    min-height: 48px;
  }

  .checkbox-field input {
    width: auto;
    min-height: auto;
  }

  .honeypot {
    position: absolute;
    left: -100vw;
  }

  @media (max-width: 1100px) {
    .feature-grid,
    .partner-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature-grid article:nth-child(2n),
    .partner-list p:nth-child(2n) {
      border-right: 0;
    }
  }

  @media (max-width: 900px) {
    .data-section,
    .partner-layout,
    .process-layout,
    .inquiry-grid,
    .validation-grid,
    .details-list div,
    .feature-grid,
    .partner-list {
      grid-template-columns: 1fr;
    }

    .feature-grid article,
    .partner-list p {
      border-right: 0;
      border-bottom: 1px solid rgba(31, 25, 21, 0.16);
    }

    .feature-grid article:last-child,
    .partner-list p:last-child {
      border-bottom: 0;
    }
  }
</style>
