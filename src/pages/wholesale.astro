---
/*
  The trade-partner landing. It is a self-contained document rather than a
  composition of the landing components: it carries its own type system, inline
  ingredient SVGs and scroll observers, and was signed off as a whole.

  It lives here rather than in public/ for one reason — the inquiry form needs
  PUBLIC_WEB3FORMS_KEY, and a file in public/ is copied verbatim with no access
  to the environment. Generated from the approved prototype; see
  docs/superpowers/plans/2026-08-22-b2b-typography-and-formula-refinement.md.
*/
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
const showForm = Boolean(web3formsKey);
const thankYouUrl = new URL("/thank-you", Astro.site).href;

const formMarkup = `<form class="form reveal" action="https://api.web3forms.com/submit" method="post"><input type="hidden" name="access_key" value="${web3formsKey}"><input type="hidden" name="from_name" value="Essenly Wholesale Page"><input type="hidden" name="redirect" value="${thankYouUrl}"><input type="hidden" name="subject" value="Wholesale inquiry from essenly.beauty"><input type="hidden" name="inquiry_type" id="b2b-inquiry-type" value="Wholesale pricing"><input type="checkbox" name="botcheck" class="b2b-botcheck" tabindex="-1" autocomplete="off"><h3>What are you looking for?</h3><div class="choices" role="radiogroup" aria-label="Inquiry type"><button class="choice selected" type="button" role="radio" aria-checked="true">Wholesale pricing</button><button class="choice" type="button" role="radio" aria-checked="false">Sample</button><button class="choice" type="button" role="radio" aria-checked="false">Both</button></div><div class="fields"><div class="field"><label for="business">BUSINESS NAME</label><input class="input" id="business" name="business_name" required placeholder="Your shop name"></div><div class="field"><label for="name">CONTACT NAME</label><input class="input" id="name" name="contact_name" autocomplete="name" required placeholder="Your name"></div><div class="field"><label for="email">BUSINESS EMAIL</label><input class="input" id="email" name="email" type="email" autocomplete="email" required placeholder="you@shop.com"></div><div class="field"><label for="web">WEBSITE OR SOCIAL ACCOUNT</label><input class="input" id="web" name="website" placeholder="Instagram or website"></div><div class="field"><label for="type">BUSINESS TYPE</label><input class="input" id="type" name="business_type" placeholder="Salon, spa, retailer…"></div><div class="field"><label for="city">CITY AND COUNTRY</label><input class="input" id="city" name="city_country" placeholder="New York, United States"></div><div class="field wide"><label for="order">ESTIMATED OPENING ORDER</label><input class="input" id="order" name="estimated_order" placeholder="Select an approximate volume"></div></div><div class="form-foot"><small>We use this information only to respond to your wholesale inquiry.</small><button class="button" type="submit">Send inquiry</button></div></form>`;
const fallbackMarkup = `<div class="form reveal"><h3>Wholesale inquiry</h3><p class="form-fallback">The inquiry form is not connected yet. Email <a href="mailto:wholesale@essenly.beauty">wholesale@essenly.beauty</a> with your shop, your clients and your estimated opening order, and we will reply with the relevant pricing or sample information.</p></div>`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Essenly for Trade Partners — Wholesale</title>
    <meta name="description" content="Wholesale pricing, samples and terms for salons, spas and retailers carrying the Essenly RenewShell Intense Hydrating Hair Mask." />
    <style is:inline>
      :root{--ink:#27201b;--copy:#665d54;--paper:#f4efe8;--bright:#fbf8f3;--line:#d8cec3;--sage:#75856b;--sage-pale:#e6e9e0;--peach:#e9b393;--footer:#27201b;--ease:cubic-bezier(.22,1,.36,1)}
      *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,sans-serif} h1,h2,h3,p{margin-top:0} h1,h2,h3{font-family:Georgia,serif;font-weight:400;letter-spacing:-.047em}.shell{width:min(1280px,calc(100% - 80px));margin:0 auto}
      .top-bar{position:sticky;top:0;z-index:20;background:rgba(244,239,232,.94);transition:box-shadow .3s var(--ease),border-color .3s var(--ease);border-bottom:1px solid transparent}.top-bar.scrolled{border-color:var(--line);box-shadow:0 8px 26px rgba(39,32,27,.05)}.nav{height:78px;display:flex;align-items:center;justify-content:space-between}.brand{font:600 21px/1 Georgia,serif;letter-spacing:.13em}.nav-right{display:flex;gap:26px;align-items:center}.nav-right span,.nav-right a{font-size:10px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;text-decoration:none}.nav-right span{color:var(--copy)}.nav-right a{color:var(--ink)}
      .eyebrow{margin:0 0 20px;color:var(--sage);font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:15px 20px;background:var(--ink);border:1px solid var(--ink);color:var(--paper);font-size:11px;font-weight:700;letter-spacing:.1em;text-decoration:none;text-transform:uppercase;transition:transform .2s var(--ease),background .2s var(--ease),color .2s var(--ease)}.button:hover{background:var(--paper);color:var(--ink);transform:translateY(-2px)}
      /* Existing hero proportions retained: content-first, no screen-height blank space. */
      .hero{padding:82px 0 72px}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;align-items:end;gap:70px}.hero h1{max-width:760px;margin-bottom:25px;font-size:clamp(50px,5.6vw,78px);line-height:.98}.hero-copy{max-width:580px;margin-bottom:34px;color:var(--copy);font-size:18px;line-height:1.6}.hero-facts{margin:0;border-top:1px solid var(--line)}.hero-facts div{display:flex;justify-content:space-between;gap:18px;padding:14px 0;border-bottom:1px solid var(--line);font-size:12px}.hero-facts dt{color:var(--copy)}.hero-facts dd{margin:0;font-weight:700;text-align:right}.scroll-cue{display:inline-flex;align-items:center;gap:10px;margin-left:28px;color:var(--copy);font-size:10px;font-weight:700;letter-spacing:.11em;text-transform:uppercase}.scroll-cue i{width:33px;height:1px;background:var(--ink);transform-origin:left;animation:line 1.8s var(--ease) infinite}@keyframes line{0%,100%{transform:scaleX(.35);opacity:.45}55%{transform:scaleX(1);opacity:1}}
      .intro{opacity:0;transform:translateY(16px);transition:opacity .7s var(--ease),transform .7s var(--ease)}body.ready .intro{opacity:1;transform:none}body.ready .intro:nth-child(2){transition-delay:.1s}body.ready .intro:nth-child(3){transition-delay:.18s}body.ready .intro:nth-child(4){transition-delay:.25s}
      .product-stage{height:108svh;position:relative}.product-scene{position:sticky;top:0;height:100svh;overflow:hidden;background:#e8e0d7}.product-scene>img{display:block;width:100%;height:100%;object-fit:cover;object-position:32% center;transform:scale(1.025);transition:transform 1.1s var(--ease)}.product-stage.visible img{transform:scale(1)}.product-panel{position:absolute;z-index:1;top:clamp(32px,7vh,72px);right:clamp(32px,7vw,120px);width:min(520px,42vw);max-height:calc(100svh - 64px);overflow:auto;padding:clamp(30px,3vw,52px) clamp(30px,3vw,52px) 36px;background:rgba(251,248,243,.97);border:1px solid rgba(216,206,195,.95);opacity:0;transform:translateY(20px);transition:opacity .7s var(--ease),transform .7s var(--ease)}.product-stage.visible .product-panel{opacity:1;transform:none}.product-panel h2{margin-bottom:20px;font-size:clamp(43px,3.65vw,60px);line-height:.99}.product-panel>p{margin-bottom:31px;color:var(--copy);font-size:16px;line-height:1.6}.specs{display:grid;grid-template-columns:1fr 1fr;gap:0 28px;border-top:1px solid var(--line)}.spec{padding:17px 0 12px;border-bottom:1px solid var(--line)}.spec span{display:block;margin-bottom:5px;color:var(--copy);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.spec strong{font-size:13px;line-height:1.35}
      .section{padding:120px 0}.formula{padding:128px 0;border-bottom:1px solid var(--line)}.formula-layout{display:grid;grid-template-columns:.78fr 1.22fr;gap:90px}.formula-intro{position:sticky;top:138px;align-self:start}.formula-intro h2{max-width:430px;margin:0 0 24px;font-size:clamp(48px,4.2vw,62px);line-height:1}.formula-intro>p:not(.eyebrow):not(.formula-status){max-width:370px;margin:0;color:var(--copy);font-size:16px;line-height:1.6}.formula-status{margin-top:54px;color:var(--sage);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.formula-beats{padding-top:11px}
      /* One restrained illustration language: hair fibre, molecular chain, and botanical source. */
      .formula-beat{min-height:54vh;display:grid;grid-template-columns:60px 210px minmax(0,1fr);gap:44px;align-content:center;align-items:center;border-top:1px solid var(--line);opacity:.28;transform:translateY(14px);transition:opacity .55s var(--ease),transform .55s var(--ease)}.formula-beat:last-child{border-bottom:1px solid var(--line)}.formula-beat.is-active{opacity:1;transform:none}.formula-number{color:var(--sage);font-size:11px;font-weight:700;letter-spacing:.1em}.ingredient-art{width:180px;height:156px;display:grid;place-items:center;overflow:visible;background:transparent;border:0}.ingredient-art svg{width:100%;height:100%;overflow:visible}.ingredient-copy h3{margin:0 0 13px;font-size:clamp(40px,4vw,60px);line-height:1}.ingredient-copy p{max-width:36ch;margin:0;color:var(--copy);font-size:17px;line-height:1.6}
      .journey{background:var(--bright);border-bottom:1px solid var(--line)}.journey-head{max-width:810px;margin-bottom:74px}.journey-head h2{margin-bottom:22px;font-size:clamp(46px,5.3vw,74px);line-height:.98}.journey-head p{max-width:560px;margin:0;color:var(--copy);font-size:17px;line-height:1.6}.journey-step{display:grid;grid-template-columns:130px 1fr minmax(250px,.7fr);gap:32px;align-items:start;min-height:230px;padding:29px 0;border-top:1px solid var(--line)}.journey-step:last-child{border-bottom:1px solid var(--line)}.journey-step .number{color:var(--sage);font-size:12px;font-weight:700;letter-spacing:.12em}.journey-step h3{margin:0;font-size:clamp(32px,3.2vw,48px);line-height:1.06}.journey-step p{max-width:360px;margin:6px 0 0;color:var(--copy);font-size:15px;line-height:1.6}
      .terms{padding:120px 0}.terms-top{display:grid;grid-template-columns:.78fr 1.22fr;gap:90px;align-items:end;margin-bottom:62px}.terms-top h2{margin:0;font-size:clamp(44px,4.4vw,65px);line-height:.98}.opening-order{display:flex;align-items:baseline;gap:18px}.opening-order strong{color:var(--sage);font:400 clamp(74px,9vw,134px)/.8 Georgia,serif;letter-spacing:-.07em}.opening-order span{max-width:165px;color:var(--copy);font-size:14px;line-height:1.45}.terms-list{border-top:1px solid var(--line)}.term{display:grid;grid-template-columns:.78fr 1.22fr;gap:90px;padding:23px 0 26px;border-bottom:1px solid var(--line)}.term>span{color:var(--sage);font-size:10px;font-weight:700;letter-spacing:.11em;text-transform:uppercase}.term strong{display:block;margin-bottom:7px;font:400 27px/1.15 Georgia,serif;letter-spacing:-.03em}.term p{max-width:650px;margin:0;color:var(--copy);font-size:14px;line-height:1.55}
      .inquiry{padding:100px 0;background:var(--footer);color:var(--paper)}.inquiry-grid{display:grid;grid-template-columns:.73fr 1.27fr;gap:78px;align-items:start}.inquiry .eyebrow{color:#bfcaaf}.inquiry h2{margin-bottom:22px;font-size:clamp(44px,4.4vw,64px);line-height:.99}.inquiry-copy{max-width:390px;color:#c8bdb1;font-size:17px;line-height:1.6}.form{padding:33px;background:rgba(251,248,243,.025);border:1px solid rgba(244,239,232,.3);box-shadow:0 24px 60px rgba(0,0,0,.2),inset 0 1px 0 rgba(255,255,255,.06)}.form h3{margin:0 0 20px;font-family:Arial,sans-serif;font-size:20px;font-weight:700;letter-spacing:-.02em}.choices{display:flex;gap:8px;margin-bottom:30px}.choice{flex:1;min-height:47px;padding:13px 10px;background:transparent;border:1px solid rgba(244,239,232,.28);color:#c8bdb1;cursor:pointer;font:700 15px Arial,sans-serif;letter-spacing:-.01em;transition:background .22s var(--ease),color .22s var(--ease),transform .22s var(--ease)}.choice.selected{background:var(--paper);color:var(--ink);transform:translateY(-2px)}.fields{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{min-height:82px}.field.wide{grid-column:1/-1}.field label{display:block;margin-bottom:9px;color:#e5d9ce;font-size:10px;font-weight:700;letter-spacing:.1em}.input{width:100%;height:48px;padding:0 15px;background:#f7f2eb;border:1px solid #f7f2eb;border-radius:4px;outline:0;color:#27201b;font:500 15px Arial,sans-serif;transition:border-color .2s var(--ease),box-shadow .2s var(--ease),transform .2s var(--ease)}.input::placeholder{color:#7b7168;opacity:1}.input:focus{border-color:#e9b393;box-shadow:0 0 0 2px #e9b393,0 0 0 5px rgba(233,179,147,.18)}.form-foot{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:31px;padding-top:22px;border-top:1px solid rgba(244,239,232,.24)}.form-foot small{max-width:330px;color:#d8cdc2;font-size:11px;line-height:1.5}.form-foot button{background:var(--paper);color:var(--ink)}footer{padding:66px 0 23px;background:var(--footer);color:var(--paper);border-top:1px solid rgba(244,239,232,.2)}.footer-top{display:flex;align-items:end;justify-content:space-between;gap:30px;padding-bottom:65px;border-bottom:1px solid rgba(244,239,232,.2)}.footer-brand{display:inline-flex;align-items:center;gap:.39em;margin:0;color:var(--paper);font:600 25px/1 var(--display);letter-spacing:.015em;text-decoration:none}.footer-brand svg{width:.91em;height:.91em;flex:none;fill:none;stroke:currentColor;stroke-width:1.35;stroke-linecap:round}.footer-brand circle{fill:var(--peach);stroke:none}.footer-statement{max-width:320px;margin:0;color:#c8bdb1;font:400 21px/1.22 Georgia,serif;text-align:right}.footer-bottom{display:flex;justify-content:space-between;gap:24px;padding-top:22px;color:#c8bdb1;font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}.footer-bottom div{display:flex;gap:23px}.footer-bottom a{color:var(--paper);text-decoration:none}
      .reveal{opacity:0;transform:translateY(18px);transition:opacity .65s var(--ease),transform .65s var(--ease)}.reveal.visible{opacity:1;transform:none}
      @media(max-width:800px){.shell{width:min(100% - 44px,1280px)}.nav-right span{display:none}.hero{padding:62px 0 68px}.hero-grid,.formula-layout,.terms-top,.inquiry-grid,.term{grid-template-columns:1fr;gap:32px}.scroll-cue{display:flex;margin:28px 0 0}.product-stage{height:100svh}.product-panel{top:auto;right:18px;bottom:18px;width:calc(100% - 36px);max-height:calc(100svh - 36px);padding:30px 26px 27px}.product-panel h2{font-size:39px}.product-panel>p{margin-bottom:20px;font-size:14px}.specs{display:none}.section,.terms,.inquiry{padding:76px 0}.formula-intro{position:relative;top:auto}.formula-status{margin-top:32px}.formula-beat{min-height:42vh;grid-template-columns:42px 112px 1fr;gap:13px}.ingredient-art{width:108px;height:108px}.ingredient-copy h3{font-size:39px}.ingredient-copy p{font-size:14px}.journey-head{margin-bottom:44px}.journey-step{grid-template-columns:52px 1fr;min-height:auto;gap:16px;padding:26px 0}.journey-step p{grid-column:2;margin-top:0}.fields{grid-template-columns:1fr}.field.wide{grid-column:auto}.choices,.form-foot,.footer-top,.footer-bottom{align-items:flex-start;flex-direction:column}.footer-statement{text-align:left}.footer-bottom div{flex-wrap:wrap;gap:14px}}
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}.product-stage{height:auto}.product-scene{position:relative;min-height:650px}.intro,.reveal,.product-panel,.formula-beat{opacity:1;transform:none}}
      /* First-pass refinement: a quiet salon editorial system, not a scroll-driven science gallery. */
      :root{--display:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;--sans:"Avenir Next","Helvetica Neue",Arial,sans-serif}
      body{font-family:var(--sans)}h1,h2,h3{font-family:var(--display);letter-spacing:-.028em}.shell{width:min(1200px,calc(100% - 80px))}
      .top-bar{background:var(--paper)}.nav{height:72px}.brand-lockup{display:inline-flex;align-items:center;gap:9px;color:var(--ink);text-decoration:none}.brand-mark{width:21px;height:21px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-width:1.35}.brand-mark circle{fill:var(--peach);stroke:none}.brand{font:600 23px/1 var(--display);letter-spacing:.015em}.nav-right{gap:24px}.nav-right span,.nav-right a{font-family:var(--sans)}
      .hero h1{font-size:clamp(68px,5.2vw,76px);letter-spacing:-.032em}.hero-copy{max-width:42ch;font-size:16px;line-height:1.6}.product-panel h2,.journey-head h2,.terms-top h2,.inquiry h2{letter-spacing:-.028em}.journey-head p,.inquiry-copy{font-size:16px}.journey-step h3{font-size:clamp(30px,3vw,42px)}.journey-step p{font-size:16px}.term strong{font-family:var(--display)}.form h3,.choice,.input{font-family:var(--sans)}
      @media(max-width:800px){.shell{width:min(100% - 44px,1200px)}.nav{height:64px}.formula{padding:76px 0}.formula-layout{display:block}.formula-intro{position:relative;top:auto;margin-bottom:32px}.formula-intro h2{font-size:40px;line-height:1.06}.formula-status{margin-top:32px}.formula-beat{min-height:44svh;grid-template-columns:42px minmax(0,1fr);gap:16px;padding:26px 0}.formula-number{align-self:start;padding-top:4px}.ingredient-art{width:152px;height:128px;grid-column:2}.ingredient-copy{grid-column:2}.ingredient-copy h3{font-size:38px;line-height:1.04}.ingredient-copy p{font-size:16px}.nav-right{gap:16px}.field{min-height:78px}.input{height:46px}}
    .b2b-botcheck{position:absolute!important;left:-9999px!important;opacity:0!important;pointer-events:none}.form-fallback{margin:0;color:#c8bdb1;font-size:15px;line-height:1.6}.form-fallback a{color:var(--paper)}
    </style>
