---
import Base from "../layouts/Base.astro";
import { getContactEmail, siteConfig, thankYouUrl } from "../data/siteConfig";

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
const showForm = Boolean(web3formsKey);
const contactMethods = [
  ["General inquiries", siteConfig.contact.generalEmail],
  ["U.S. wholesale", siteConfig.contact.wholesaleEmail],
  ["Press and partnerships", siteConfig.contact.pressEmail],
].filter((method): method is [string, string] => Boolean(method[1]));
const fallbackEmail = getContactEmail();
---

<Base
  title="Contact Essenly"
  description={`Contact ${siteConfig.company.legalName} for product, U.S. wholesale, press and partnership inquiries.`}
  canonicalPath="/contact"
>
  <section class="section contact-hero">
    <div class="narrow stack">
      <p class="eyebrow">Contact</p>
      <h1>Let's talk</h1>
      <p class="lead">
        For product, wholesale, press and partnership inquiries, contact the Essenly team.
      </p>
      <p class="hero-direct">
        Use the form below, or email
        <a href={`mailto:${fallbackEmail}`}>{fallbackEmail}</a> directly.
      </p>
      <div class="button-row">
        <a class="btn btn-primary" href="#inquiry">Send an Inquiry</a>
      </div>
    </div>
  </section>

  {/*
    Only worth its own section once there is more than one address to choose
    between. With a single method the grid leaves an orphaned card, and the
    hero above already names that address.
  */}
  {contactMethods.length > 1 && (
    <section class="section-tight">
      <div class="container contact-grid">
        {contactMethods.map(([label, email]) => (
          <article class="info-card">
            <h2>{label}</h2>
            <a href={`mailto:${email}`}>{email}</a>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="section rose-band" id="inquiry">
    <div class="container form-layout">
      <div class="stack">
        <p class="eyebrow">Inquiry</p>
        <h2>Send the right note to the right place</h2>
        <p class="lead">Choose what your message is about and tell us what you are looking for.</p>
        <div class="side-note">
          <p class="muted">
            Stocking Essenly? The wholesale form asks the few extra questions we need to
            quote you.
          </p>
          <a class="btn btn-secondary" href="/wholesale#inquiry">Go to the Wholesale Form</a>
        </div>
        <p class="muted">
          Urgent? Email <a href={`mailto:${fallbackEmail}`}>{fallbackEmail}</a> directly.
        </p>
      </div>
      {showForm ? (
        <form class="contact-form" action="https://api.web3forms.com/submit" method="post">
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="New contact inquiry — Essenly" />
          <input type="hidden" name="from_name" value="Essenly Website" />
          <input type="hidden" name="redirect" value={thankYouUrl} />
          <input type="checkbox" name="botcheck" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <fieldset class="inquiry-type">
            <legend>What is this about?</legend>
            <label><input type="radio" name="inquiry_type" value="Product question" required /> Product question</label>
            <label><input type="radio" name="inquiry_type" value="Press" /> Press</label>
            <label><input type="radio" name="inquiry_type" value="Partnership" /> Partnership</label>
            <label><input type="radio" name="inquiry_type" value="Other" /> Other</label>
          </fieldset>
          <div class="form-grid">
            <div class="field">
              <label for="contact-name">Contact name</label>
              <input id="contact-name" name="contact_name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field full">
              <label for="company">Company</label>
              <input id="company" name="company" autocomplete="organization" />
            </div>
            <div class="field full">
              <label for="message">Message</label>
              <textarea id="message" name="message" required></textarea>
            </div>
          </div>
          <button class="btn btn-primary" type="submit">Send Inquiry</button>
          <p class="fine-print">By submitting, you agree that Essenly may use your information to respond to your inquiry.</p>
        </form>
      ) : (
        fallbackEmail && (
          <div class="email-panel">
            <p>For current inquiries, email the Essenly team directly.</p>
            <a class="btn btn-primary" href={`mailto:${fallbackEmail}`}>Send Inquiry</a>
            <a class="btn btn-secondary" href="/wholesale#inquiry">Wholesale Information</a>
          </div>
        )
      )}
    </div>
  </section>

  <section class="section-tight">
    <div class="narrow stack">
      <p class="eyebrow">Company</p>
      <h2>{siteConfig.company.legalName}</h2>
      <p class="lead">{siteConfig.company.city}, {siteConfig.company.country}</p>
      {siteConfig.company.businessAddress && <p class="muted">{siteConfig.company.businessAddress}</p>}
    </div>
  </section>
</Base>

<style>
  .contact-hero {
    text-align: center;
  }

  .contact-hero .button-row {
    justify-content: center;
  }

  .hero-direct {
    color: var(--color-muted);
  }

  /* :not(.btn) matters — these selectors out-specify .btn-secondary, so without
     it the wholesale button's text would be repainted accent-dark. */
  .hero-direct a:not(.btn),
  .form-layout .stack a:not(.btn) {
    color: var(--color-accent-dark);
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .side-note {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-5);
    border: 1px solid rgba(31, 25, 21, 0.16);
    border-radius: var(--radius);
    background: rgba(255, 250, 244, 0.5);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-5);
  }

  .contact-grid h2 {
    margin-bottom: var(--space-3);
    font-size: 1rem;
    font-family: var(--font-body);
    text-transform: uppercase;
  }

  .contact-grid a {
    color: var(--color-accent-dark);
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .form-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--space-7);
    align-items: start;
  }

  /* .stack is a grid, so without this it stretches to the form's height and
     spreads the eyebrow, heading and copy apart down the column. */
  .form-layout .stack {
    align-content: start;
  }

  .contact-form,
  .email-panel {
    display: grid;
    gap: var(--space-5);
  }

  /* Same shape as the wholesale radio group, but this sits on .rose-band, so
     the text stays dark rather than the light treatment used on .dark-band. */
  .inquiry-type {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .inquiry-type legend {
    margin-bottom: var(--space-2);
    padding: 0;
    font-weight: 800;
  }

  .inquiry-type label {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    min-height: 44px;
  }

  .inquiry-type input {
    width: auto;
    min-height: auto;
  }

  .email-panel {
    align-content: start;
    padding: var(--space-5);
    border: 1px solid rgba(31, 25, 21, 0.14);
    border-radius: var(--radius);
    background: rgba(255, 250, 244, 0.42);
  }

  .email-panel .btn {
    justify-self: start;
  }

  .honeypot {
    position: absolute;
    left: -100vw;
  }

  @media (max-width: 900px) {
    .form-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
