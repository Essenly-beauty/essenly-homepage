---
import Legal from "../layouts/Legal.astro";
import { siteConfig } from "../data/siteConfig";
---

<Legal
  title="Terms of Use"
  description={`Terms of use for ${siteConfig.company.legalName}`}
  canonicalPath="/terms"
  eyebrow="Legal"
  heading="Terms of Use"
>
  <p>These terms describe general use of the Essenly website and inquiry process.</p>

  <h2>Website content</h2>
  <p>
    Product and company information on this website is provided for general information and may be
    updated as verified details become available.
  </p>

  <h2>Wholesale inquiries</h2>
  <p>
    Wholesale information submitted through this website does not create a binding agreement.
    Orders, pricing, payment and shipment are handled through direct quotation and invoice.
  </p>

  <h2>External links</h2>
  <p>
    Amazon and social media links may direct visitors to third-party websites with separate terms
    and policies.
  </p>

  <h2>Contact</h2>
  <p>
    For questions about these terms, use the <a href="/#contact">inquiry form</a> or email the
    Essenly team directly.
  </p>
</Legal>
