---
import Landing from "../layouts/Landing.astro";
import Archive from "../components/landing/Archive.astro";
import BrandBand from "../components/landing/BrandBand.astro";
import Contact from "../components/landing/Contact.astro";
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Hero from "../components/landing/Hero.astro";
import InfoHeadline from "../components/landing/InfoHeadline.astro";
import Philosophy from "../components/landing/Philosophy.astro";
import Pictorial from "../components/landing/Pictorial.astro";
import Product from "../components/landing/Product.astro";
import Science from "../components/landing/Science.astro";
import Wholesale from "../components/landing/Wholesale.astro";
---

<Landing title="Essenly | Sensorial Korean Hair Care">
  <Header />
  <main>
    <Hero />
    <InfoHeadline />
    <Pictorial />
    <Philosophy />
    <BrandBand />
    <Product />
    <Science />
    <Archive />
    <Wholesale />
    <Contact />
  </main>
  <Footer />
</Landing>

<script>
  import { initLandingAccordion } from "../scripts/landing-accordion";
  import { initLandingTabs } from "../scripts/landing-tabs";

  /* Tabs and the accordion first: they are the interactive parts, and neither
     depends on the motion layer coming up. */
  initLandingTabs();
  initLandingAccordion();

  /* The motion layer is imported dynamically behind the very query it gates on.
     GSAP + ScrollTrigger + Lenis are ~136KB of the ~138KB this page's JS weighs;
     statically importing them meant every phone and every reduced-motion visitor
     downloaded and parsed the whole thing only for matchMedia to decide, inside
     the module, not to use any of it.

     The change listener is not optional: without it a visitor who loads at
     1279px and widens the window would stay on the static page for the rest of
     the session. Once the module is in, its own gsap.matchMedia() handles
     teardown and setup across the breakpoint. */
  const wantsMotion = window.matchMedia(
    "(min-width: 1280px) and (prefers-reduced-motion: no-preference)"
  );

  let motionRequested = false;

  async function loadMotion() {
    if (motionRequested || !wantsMotion.matches) return;
    motionRequested = true;
    const { initLandingMotion } = await import("../scripts/landing-motion");
    initLandingMotion();
  }

  loadMotion();
  wantsMotion.addEventListener("change", loadMotion);
</script>
