---
import ImageAsset from "../components/ImageAsset.astro";
import Base from "../layouts/Base.astro";
import { siteConfig } from "../data/siteConfig";
---

<Base title="Essenly | Korean Hair Care">
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Korean hair care</p>
        <h1>Hair care that stays with you.</h1>
        <p class="lead">
          A rich Korean hair mask loved for lightweight softness, glossy movement and a warm Amber Vanilla finish.
        </p>
        <div class="button-row">
          <a class="btn btn-primary" href={siteConfig.amazonUrl} target="_blank" rel="noopener noreferrer">
            Shop on Amazon
          </a>
          <a class="btn btn-secondary" href="/wholesale">Wholesale</a>
        </div>
        <div class="hero-meta" aria-label="Product highlights">
          <span>Made in Korea</span>
          <span>Amber Vanilla</span>
          <span>Amazon U.S.</span>
        </div>
      </div>
      <ImageAsset
        src="/images/essenly/essenly-product-hero.png"
        name="Homepage Hero Image"
        ratio="16:10 desktop, 4:5 mobile"
        description="Essenly Hair Mask photographed in warm natural light with the product clearly visible."
        notes="Use ivory, amber, sand or muted brown. Avoid text, badges and catalog-style cutouts."
        alt="Essenly Keratin Hair Mask photographed in warm natural light"
      />
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="stack">
        <p class="eyebrow">Hero product</p>
        <h2>One treatment. A softer ritual.</h2>
        <p class="lead">
          {siteConfig.product.name} is a rich but lightweight Korean hair treatment
          customers describe as softening, smoothing and glossy without a heavy finish.
        </p>
        <p class="muted">Finished with our signature {siteConfig.product.fragrance} scent, one of the product details customers mention most.</p>
        <div class="product-facts">
          <span>{siteConfig.product.countryOfOrigin}</span>
          <span>{siteConfig.product.fragrance}</span>
          <span>Limited U.S. wholesale</span>
        </div>
      </div>
      <ImageAsset
        src="/images/essenly/essenly-product-texture.png"
        name="Open Product Image"
        ratio="4:5"
        description="Open jar or container with the conditioning texture clearly visible."
        notes="Warm neutral background. Optional hand interaction. High-resolution crop."
        alt="Open Essenly Hair Mask showing its rich conditioning texture"
      />
    </div>
  </section>

  <section class="section sage-band">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Benefits</p>
        <h2>Softness, shine and scent.</h2>
        <p class="lead">Three reasons the mask belongs on a bathroom shelf, salon backbar or beauty retail edit.</p>
      </div>
      <div class="benefit-grid">
        <article class="info-card">
          <h3>Lightweight softness</h3>
          <p class="muted">Customers mention hair that feels soft and moisturized without a greasy or weighed-down finish.</p>
        </article>
        <article class="info-card">
          <h3>Frizz-smoothing shine</h3>
          <p class="muted">Reviewers describe a more polished look after blow-drying or air-drying, with visible shine.</p>
        </article>
        <article class="info-card">
          <h3>Amber Vanilla finish</h3>
          <p class="muted">A warm, soft fragrance that customers call elevated, memorable and not overpowering.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section review-band">
    <div class="container review-layout">
      <div class="review-score">
        <span>{siteConfig.amazonProof.rating}</span>
        <p>out of 5 on Amazon</p>
      </div>
      <div class="stack">
        <p class="eyebrow">Customer loved</p>
        <h2>Rich texture. Lightweight finish. Amber Vanilla everything.</h2>
        <p class="lead">
          Based on Amazon customer feedback, Essenly is most often appreciated for
          soft, glossy hair feel, frizz control, a concentrated creamy texture and premium packaging.
        </p>
        <div class="review-points">
          <span>{siteConfig.amazonProof.reviewCount} ratings</span>
          <span>96% four or five stars</span>
          <span>0% one or two stars</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split reverse">
      <ImageAsset
        src="/images/essenly/essenly-product-ritual.png"
        name="Ritual Image"
        ratio="4:5"
        description="Hair care ritual with damp hair, towel, shower environment or hand applying product."
        notes="Editorial rather than instructional. Avoid medical before-and-after visuals."
        alt="Hair care ritual featuring the Essenly Hair Mask"
      />
      <div class="stack">
        <p class="eyebrow">Texture and ritual</p>
        <h2>Five minutes, then softer hair.</h2>
        <p class="lead">
          Apply to damp hair after shampooing, focusing on the mid-lengths and ends.
          Leave on for 5-7 minutes, then rinse thoroughly.
        </p>
        <p class="muted">
          Customers often describe the routine as easy to add to a shower ritual, with a soft hair feel after rinsing.
          Final directions should be confirmed against the current U.S. product label.
        </p>
      </div>
    </div>
  </section>

  <section class="section rose-band">
    <div class="container split">
      <div class="stack">
        <p class="eyebrow">Ingredients</p>
        <h2>Conditioning care, made in Korea.</h2>
        <p class="lead">
          Current ingredient highlights include Keratin, Collagen and Shea Butter.
          The exact INCI list should be verified before publication.
        </p>
        <ul class="ingredient-list">
          <li>Keratin</li>
          <li>Collagen</li>
          <li>Shea Butter</li>
        </ul>
      </div>
      <ImageAsset
        src="/images/essenly/essenly-product-texture.png"
        name="Ingredient Still Life"
        ratio="1:1"
        description="Conditioning texture or refined ingredient still life."
        notes="Do not use misleading raw ingredient imagery until the full INCI list is verified."
        alt="Conditioning texture and ingredients associated with the Essenly Hair Mask"
      />
    </div>
  </section>

  <section class="section dark-band">
    <div class="container amazon-band">
      <div class="stack">
        <p class="eyebrow">Amazon U.S.</p>
        <h2>Available in the U.S. on Amazon</h2>
        <p class="lead">Discover Essenly through our official U.S. Amazon listing, where customers are already responding to the mask's lightweight finish, scent and shelf appeal.</p>
        <div class="review-summary">
          <span>{siteConfig.amazonProof.rating} out of 5</span>
          <span>{siteConfig.amazonProof.reviewCount} ratings</span>
          <span>5-star majority</span>
        </div>
        <a class="btn btn-light" href={siteConfig.amazonUrl} target="_blank" rel="noopener noreferrer">
          Shop on Amazon
        </a>
      </div>
      <ImageAsset
        src="/images/essenly/essenly-product-box.png"
        name="Amazon CTA Product Image"
        ratio="4:5"
        description="Clean product-only scene suitable for a direct purchase call-to-action."
        notes="No Amazon logo embedded into the image."
        alt="Essenly Keratin Hair Mask product image for Amazon U.S. purchase"
      />
    </div>
  </section>

  <section class="section wholesale-preview">
    <div class="narrow stack">
      <p class="eyebrow">Wholesale</p>
      <h2>For retailers, salons and spas</h2>
      <p class="lead">
        Essenly is available to selected wholesale partners in the United States.
      </p>
      <a class="btn btn-primary" href="/wholesale">Explore Wholesale</a>
    </div>
  </section>

  <section class="section-tight" id="our-story">
    <div class="narrow stack">
      <p class="eyebrow">About Essenly</p>
      <h2>Beauty experiences from Seoul, made for global customers.</h2>
      <p class="lead">
        Essenly Co., Ltd. is a Seoul-based beauty company developing Korean beauty products and
        experiences for global customers.
      </p>
      <p class="muted">
        Our first release is an intensive hair mask created in Korea, combining effective
        conditioning care with a distinctive sensory experience.
      </p>
    </div>
  </section>
</Base>

<style>
  .home-hero {
    position: relative;
    padding-block: clamp(4.5rem, 10vw, 8rem) clamp(5.5rem, 10vw, 9rem);
    border-bottom: 1px solid rgba(31, 25, 21, 0.12);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    text-align: center;
  }

  .amazon-band {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    max-width: 980px;
    margin-inline: auto;
  }

  .hero-copy h1 {
    max-width: 780px;
  }

  .hero-copy .lead {
    max-width: 520px;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin-top: var(--space-2);
  }

  .hero-meta span {
    padding: 0.45rem 0.7rem;
    border: 1px solid rgba(31, 25, 21, 0.16);
    border-radius: 999px;
    background: rgba(255, 250, 244, 0.4);
    color: rgba(31, 25, 21, 0.7);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .home-hero .image-asset,
  .home-hero .placeholder-asset {
    width: min(100%, 1060px);
    min-height: clamp(360px, 50vw, 640px);
    margin-inline: auto;
  }

  .section-head {
    display: grid;
    gap: var(--space-4);
    max-width: 760px;
    margin-bottom: var(--space-7);
    margin-inline: auto;
    text-align: center;
  }

  .product-facts,
  .review-summary,
  .review-points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .product-facts span,
  .review-summary span,
  .review-points span {
    padding: 0.5rem 0.72rem;
    border: 1px solid rgba(31, 25, 21, 0.14);
    border-radius: 999px;
    background: rgba(255, 250, 244, 0.42);
    color: var(--color-muted);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .review-band {
    background: var(--color-surface);
    border-block: 1px solid rgba(31, 25, 21, 0.12);
  }

  .review-layout {
    display: grid;
    grid-template-columns: minmax(220px, 0.45fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: center;
  }

  .review-score {
    display: grid;
    min-height: 260px;
    place-items: center;
    border: 1px solid rgba(31, 25, 21, 0.16);
    border-radius: 999px;
    background: linear-gradient(180deg, #f6d6cb, #f1b6a8);
    text-align: center;
  }

  .review-score span {
    display: block;
    font-size: clamp(4.5rem, 12vw, 9rem);
    font-weight: 800;
    line-height: 0.88;
  }

  .review-score p {
    max-width: 10ch;
    color: rgba(31, 25, 21, 0.68);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .ingredient-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .ingredient-list li {
    padding: 0.72rem 0.95rem;
    border: 1px solid rgba(36, 30, 25, 0.22);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.56);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .dark-band .placeholder-asset {
    color: var(--color-text);
  }

  .dark-band .review-summary span {
    border-color: rgba(255, 253, 248, 0.22);
    background: rgba(255, 253, 248, 0.08);
    color: rgba(255, 253, 248, 0.78);
  }

  .wholesale-preview {
    text-align: center;
  }

  .wholesale-preview .btn {
    justify-self: center;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .amazon-band,
    .review-layout {
      grid-template-columns: 1fr;
    }

    .review-score {
      width: min(100%, 340px);
      min-height: 220px;
      margin-inline: auto;
    }
  }
</style>
