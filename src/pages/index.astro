---
/*
  The site. This layout began as the trade-partner page at /wholesale and is now
  the whole of it — the consumer-facing landing it replaced is still in
  src/components/landing/, unused, if it is ever wanted back.

  It is a self-contained document rather than a composition of those components:
  it carries its own type system, inline ingredient SVGs and scroll observers,
  and was signed off as a whole. See
  docs/superpowers/plans/2026-08-22-b2b-typography-and-formula-refinement.md.
*/
import { amazonUrl } from "../data/siteConfig";
import Wordmark from "../components/landing/Wordmark.astro";

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
const showForm = Boolean(web3formsKey);
const thankYouUrl = new URL("/thank-you", Astro.site).href;

const formMarkup = `<form class="form reveal" action="https://api.web3forms.com/submit" method="post"><input type="hidden" name="access_key" value="${web3formsKey}"><input type="hidden" name="from_name" value="Essenly Wholesale Page"><input type="hidden" name="redirect" value="${thankYouUrl}"><input type="hidden" name="subject" value="Wholesale inquiry from essenly.beauty"><input type="hidden" name="inquiry_type" id="b2b-inquiry-type" value="Wholesale pricing"><input type="checkbox" name="botcheck" class="b2b-botcheck" tabindex="-1" autocomplete="off"><h3>What are you looking for?</h3><div class="choices" role="radiogroup" aria-label="Inquiry type"><button class="choice selected" type="button" role="radio" aria-checked="true">Wholesale pricing</button><button class="choice" type="button" role="radio" aria-checked="false">Sample</button><button class="choice" type="button" role="radio" aria-checked="false">Both</button></div><div class="fields"><div class="field"><label for="business">BUSINESS NAME</label><input class="input" id="business" name="business_name" required placeholder="Your shop name"></div><div class="field"><label for="name">CONTACT NAME</label><input class="input" id="name" name="contact_name" autocomplete="name" required placeholder="Your name"></div><div class="field"><label for="email">BUSINESS EMAIL</label><input class="input" id="email" name="email" type="email" autocomplete="email" required placeholder="you@shop.com"></div><div class="field"><label for="web">WEBSITE OR SOCIAL ACCOUNT</label><div class="combo"><select class="input combo__pick" id="web-kind" name="online_channel" aria-label="Kind of account"><option selected>Instagram</option><option>Website</option><option>TikTok</option><option>YouTube</option><option>Facebook</option><option>Other</option></select><input class="input combo__value" id="web" name="website" placeholder="@yourshop, or a link"></div></div><div class="field"><label for="type">BUSINESS TYPE</label><select class="input