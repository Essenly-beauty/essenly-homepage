---
/*
  Layout for the pages the one-page site does not absorb: privacy, terms and the
  post-submit thank-you.

  It used to wrap the old landing layout, so following a footer link dropped the
  visitor onto the previous design — Inter on white, a hamburger, a black CTA
  block — none of which exists on the site any more. It is self-contained now and
  carries the same tokens, serif and chrome as the homepage.

  The homepage's markup is not shared from here on purpose: that page is one
  signed-off document with its own scroll choreography, and these pages need only
  its header, its footer and its type.
*/
import Wordmark from "../components/landing/Wordmark.astro";
import { amazonUrl, siteConfig } from "../data/siteConfig";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  eyebrow: string;
  heading: string;
  noindex?: boolean;
}

const { title, description, canonicalPath, eyebrow, heading, noindex } = Astro.props;
const canonical = canonicalPath ? new URL(canonicalPath, Astro.site).href : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Essenly</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline>
      :root{--ink:#27201b;--copy:#665d54;--paper:#f4efe8;--bright:#fbf8f3;--line:#d8cec3;--sage:#75856b;--peach:#e9b393;--footer:#27201b;--ease:cubic-bezier(.22,1,.36,1);--display:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;--sans:"Avenir Next","Helvetica Neue",Arial,sans-serif}
      *{box-sizing:border-box}
      html{scroll-behavior:smooth}
      body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);display:flex;flex-direction:column;min-height:100vh}
      h1,h2,h3{margin-top:0;font-family:var(--display);font-weight:400;letter-spacing:-.032em}
      .shell{width:min(1200px,calc(100% - 80px));margin:0 auto}
      .top-bar{background:var(--paper);border-bottom:1px solid transparent}
      .nav{height:72px;display:flex;align-items:center;justify-content:space-between}
      .nav-right{display:flex;gap:24px;align-items:center}
      .nav-right span,.nav-right a{font-family:var(--sans);font-size:10px;font-weight:700;letter-spacing:.11em;text-transform:uppercase}
      .nav-right span{color:var(--copy)}
      .nav-right a{color:var(--ink);text-decoration:none}
      .site-brand--head{font-size:23px;color:var(--ink)}
      .site-brand--foot{font-size:27px;color:var(--paper)}

      /* The page is a single column of prose; it gets the hero's opening
         proportions rather than the landing's tighter section rhythm. */
      main{flex:1 0 auto;padding:96px 0 128px}
      .eyebrow{margin:0 0 20px;color:var(--sage);font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}
      h1{max-width:16ch;margin:0 0 34px;font-size:clamp(46px,5vw,68px);line-height:.99}
      .legal-body{max-width:64ch}
      .legal-body p{margin:0 0 20px;color:var(--copy);font-size:17px;line-height:1.66}
      .legal-body h2{margin:52px 0 14px;font-size:clamp(26px,2.4vw,32px);line-height:1.12}
      /* :not(.button) matters: the actions sit inside the prose, and a bare
         `.legal-body a` outranks `.button`, which painted the solid button's
         label in ink on ink and underlined it. */
      .legal-body a:not(.button){color:var(--ink);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px;text-decoration-color:var(--peach)}
      .legal-body a:not(.button):hover{text-decoration-color:var(--ink)}
      .legal-body ul{margin:0 0 20px;padding-left:20px;color:var(--copy);font-size:17px;line-height:1.66}
      .legal-body li{margin-bottom:8px}

      .legal-actions{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-top:52px;padding-top:36px;border-top:1px solid var(--line)}
      .button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:15px 22px;background:var(--ink);border:1px solid var(--ink);color:var(--paper);cursor:pointer;font-size:11px;font-weight:700;letter-spacing:.1em;text-decoration:none;text-transform:uppercase;transition:background .2s var(--ease),color .2s var(--ease),border-color .2s var(--ease)}
      .button:hover{background:var(--peach);border-color:var(--peach);color:var(--ink)}
      .button--quiet{background:transparent;border-color:var(--line);color:var(--ink)}
      .button--quiet:hover{background:var(--ink);border-color:var(--ink);color:var(--paper)}
      .button:focus-visible{outline:2px solid var(--peach);outline-offset:3px}

      footer{padding:66px 0 23px;background:var(--footer);color:var(--paper)}
      .footer-top{display:flex;align-items:end;justify-content:space-between;gap:30px;padding-bottom:56px;border-bottom:1px solid rgba(244,239,232,.2)}
      .footer-statement{max-width:320px;margin:0;color:#c8bdb1;font:400 21px/1.22 var(--display);text-align:right}
      .footer-bottom{display:flex;justify-content:space-between;gap:24px;padding-top:22px;color:#c8bdb1;font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}
      .footer-bottom div{display:flex;gap:23px}
      .footer-bottom a{color:var(--paper);text-decoration:none}

      @media(max-width:800px){
        .shell{width:min(100% - 44px,1200px)}
        .nav{height:64px}
        .nav-right span{display:none}
        main{padding:64px 0 88px}
        h1{font-size:40px;line-height:1.05}
        .site-brand--head{font-size:20px}
        .site-brand--foot{font-size:23px}
        .footer-top,.footer-bottom{flex-direction:column;align-items:flex-start}
        .footer-statement{text-align:left}
        .footer-bottom div{flex-wrap:wrap;gap:14px}
      }
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
    </style>
  </head>
  <body>
    <header class="top-bar">
      <nav class="shell nav">
        <Wordmark class="site-brand site-brand--head" href="/" />
        <div class="nav-right">
          <span>Trade partners</span>
          <a href="/#inquiry">Wholesale inquiry</a>
        </div>
      </nav>
    </header>

    <main>
      <div class="shell">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        <div class="legal-body"><slot /></div>
      </div>
    </main>

    <footer>
      <div class="shell">
        <div class="footer-top">
          <Wordmark class="site-brand site-brand--foot" href="/" />
          <p class="footer-statement">Premium Korean hair care for considered rituals.</p>
        </div>
        <div class="footer-bottom">
          <span>© {siteConfig.company.legalName}</span>
          <div>
            <a href="/#inquiry">Wholesale inquiry</a>
            <a href={amazonUrl} target="_blank" rel="noopener noreferrer">Amazon U.S.</a>
            <a href="/privacy">Privacy</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
