---
import BrandLogo from "../components/BrandLogo.astro";
import { navItems, siteConfig } from "../data/siteConfig";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
}

const {
  title,
  description = "Discover Essenly, a Seoul-based beauty company and the maker of a conditioning Korean hair mask available in the United States.",
  canonicalPath = Astro.url.pathname,
  ogImage,
} = Astro.props;

const fullTitle = title.includes("Essenly") ? title : `${title} | Essenly`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? "https://essenly.beauty").toString();
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteConfig.company.legalName,
  url: "https://essenly.beauty",
  sameAs: [siteConfig.social.instagram],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Essenly" />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="wordmark" aria-label="Essenly home"><BrandLogo /></a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href={siteConfig.amazonUrl} target="_blank" rel="noopener noreferrer">Amazon</a>
        </nav>
        <a class="header-cta" href={siteConfig.amazonUrl} target="_blank" rel="noopener noreferrer">
          Shop Amazon
        </a>
        <details class="mobile-menu">
          <summary aria-label="Open menu"><span></span><span></span><span></span></summary>
          <nav aria-label="Mobile navigation">
            {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href={siteConfig.amazonUrl} target="_blank" rel="noopener noreferrer">Shop on Amazon</a>
          </nav>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a href="/" class="wordmark"><BrandLogo /></a>
          <p>{siteConfig.company.legalName}</p>
          <p>{siteConfig.company.description}</p>
        </div>
        <div>
          <h2>Explore</h2>
          <a href="/product">Product</a>
          <a href="/wholesale">Wholesale</a>
          <a href={siteConfig.amazonUrl} target="_blank" rel="noopener noreferrer">Amazon U.S.</a>
          <a href="/contact">Contact</a>
        </div>
        <div>
          <h2>Contact</h2>
          <p>General inquiry: to be confirmed</p>
          <a href="mailto:wholesale@essenly.beauty">wholesale@essenly.beauty</a>
          <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        </div>
        <div>
          <h2>Legal</h2>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <p>&copy; {new Date().getFullYear()} Essenly. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
