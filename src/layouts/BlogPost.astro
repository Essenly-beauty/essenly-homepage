---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  author: string;
  tags: string[];
}

const { title, description, date, author, tags } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description}>
  <article class="post">
    <div class="container post-inner">
      <header class="post-header">
        <div class="post-meta">
          <time datetime={date}>{formattedDate}</time>
          <span class="post-author">by {author}</span>
        </div>
        <h1>{title}</h1>
        <p class="post-desc">{description}</p>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="post-body">
        <slot />
      </div>

      <footer class="post-footer">
        <div class="post-cta">
          <h3>Coming to Seoul?</h3>
          <p>Get a free Essenly hair kit and personalized K-beauty recommendations.</p>
          <a href="/#kit" class="btn btn-primary">Get Your Free Kit</a>
        </div>
        <a href="/blog" class="back-link">Back to all articles</a>
      </footer>
    </div>
  </article>
</Base>

<style>
  .post {
    padding: var(--space-2xl) 0;
  }
  .post-inner {
    max-width: 720px;
  }
  .post-header {
    margin-bottom: var(--space-2xl);
  }
  .post-meta {
    display: flex;
    gap: var(--space-md);
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-bottom: var(--space-md);
  }
  .post-header h1 {
    font-size: 2.5rem;
    margin-bottom: var(--space-md);
  }
  .post-desc {
    font-size: 1.125rem;
    color: var(--text-secondary);
  }
  .post-tags {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  .tag {
    background: var(--accent-light);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-full);
  }

  .post-body {
    font-size: 1.0625rem;
    line-height: 1.8;
  }
  .post-body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
  }
  .post-body :global(h3) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }
  .post-body :global(p) {
    margin-bottom: var(--space-md);
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-xl);
  }
  .post-body :global(li) {
    margin-bottom: var(--space-sm);
  }
  .post-body :global(strong) {
    font-weight: 600;
  }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-md);
    color: var(--text-secondary);
    font-style: italic;
    margin: var(--space-lg) 0;
  }

  .post-footer {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }
  .post-cta {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .post-cta h3 {
    margin-bottom: var(--space-sm);
  }
  .post-cta p {
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
  }
  .back-link {
    display: inline-block;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .post-header h1 { font-size: 1.875rem; }
  }
</style>
